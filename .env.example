# ---------------------------------------------------------------------------
# Which free LLM provider to use: "openrouter" (default) or "groq".
# Both are OpenAI-compatible, so switching is a one-line change.
# ---------------------------------------------------------------------------
LLM_PROVIDER=openrouter

# API keys. You only need the one for the provider you selected.
#   OpenRouter: https://openrouter.ai/keys   (free models end in ":free")
#   Groq:       https://console.groq.com/keys
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Optional model override. Leave blank to use the provider default
# (see PROVIDER_DEFAULTS in src/config.py).
#   OpenRouter: inclusionai/ling-3.2-flash:free
#   Groq:       openai/gpt-oss-120b
LLM_MODEL=

# ---------------------------------------------------------------------------
# What to test
# ---------------------------------------------------------------------------
TARGET_URL=https://demo.playwright.dev/todomvc

# ---------------------------------------------------------------------------
# Guardrails (the loop-safety budget)
# ---------------------------------------------------------------------------
MAX_STEPS=25
REPEAT_NUDGE=3
REPEAT_ABORT=5
STAGNATION_NUDGE=4
STAGNATION_ABORT=8
MAX_VERDICT_REJECTIONS=2
SNAPSHOT_CHAR_LIMIT=6000
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=120

# ---------------------------------------------------------------------------
# Browser / Playwright MCP
# ---------------------------------------------------------------------------
HEADLESS=1
BROWSER=chromium
VIEWPORT=1280,720
# Set to 1 if Chromium refuses to start with "No usable sandbox".
MCP_NO_SANDBOX=0
# Set to a browser path if you pre-installed Chromium somewhere non-default,
# e.g. PLAYWRIGHT_BROWSERS_PATH=/path/to/browsers
PLAYWRIGHT_BROWSERS_PATH=

# ---------------------------------------------------------------------------
# Evidence
# ---------------------------------------------------------------------------
EVIDENCE_DIR=evidence
